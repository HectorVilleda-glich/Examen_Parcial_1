# PostgreSQL (local, Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URL="postgresql://usuario:password@localhost:5432/examen_i?schema=public"

# Auth.js / NextAuth (generar con: openssl rand -base64 32)
AUTH_SECRET="cambia-este-secreto-en-produccion"

# URL pública de la app (local o dominio de Vercel)
AUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID="tu-google-client-id"
GOOGLE_CLIENT_SECRET="tu-google-client-secret"
